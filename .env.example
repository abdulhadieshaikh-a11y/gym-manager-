# ---------------------------------------------------------------------------
# Gym Manager — environment variables
# Copy this file to ".env.local" (local) or add the same names in Vercel.
# NEVER commit .env.local. NEVER put a service-role / secret key here.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API (or "Data API") → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key" (starts with sb_publishable_)
# This key is PUBLIC by design: it is visible in the browser. Your data is
# protected by login + Row Level Security, not by hiding this key.
# (If your project only shows the legacy "anon" key, you can paste it here, or
#  use NEXT_PUBLIC_SUPABASE_ANON_KEY instead — both work.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional. The public address of the app, used in password-reset emails.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
